# OMEGA MODEL 2 Environment Configuration
# Copy this file to .env and fill in any keys you wish to use.
# Note: All features work offline even without API keys!

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Default Model Selection ('omega_offline', 'omega_gpt1', 'openai', 'gemini', 'anthropic', 'ollama')
OMEGA_DEFAULT_PROVIDER=omega_offline
OMEGA_DEFAULT_MODEL=omega-brain-v2

# Commercial API Keys (Optional - Never hardcode in source)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=

ANTHROPIC_API_KEY=

# Local Ollama Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434

# Sandbox Constraints
SANDBOX_TIMEOUT_SECONDS=5.0
SANDBOX_MAX_MEMORY_MB=128

